# 复制为 .env，在本机填写，重启 npm start 后生效。
# 支持提供 /chat/completions 和 JSON 模式的兼容接口。
# DeepSeek 示例：
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# Kimi 示例：LLM_BASE_URL=https://api.moonshot.cn/v1
# 模型名称以你的服务商账号当前可用列表为准。
# LLM_MODEL=moonshot-v1-8k

# 默认只监听本机，数据库会自动生成在 .local/ 中。
PORT=5174
# DATABASE_FILE=D:/your-local-folder/credit-demo.sqlite
